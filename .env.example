# Copy to .env. Platform A and Platform B, local development.
# Database: any PostgreSQL 14+ the user may create schemas in. The schemas
# (platform_a, platform_b) are fixed in platforms/config.py.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# The API key each platform's REST API accepts (X-API-Key header or Bearer).
# Use a long random value; the MCP servers read the same ones.
PLATFORM_A_API_KEY=
PLATFORM_B_API_KEY=

# Optional: where each MCP server finds its API (default http://127.0.0.1:8201 / 8202).
# PLATFORM_A_API_URL=http://127.0.0.1:8201
# PLATFORM_B_API_URL=http://127.0.0.1:8202

# The enterprise plan directory (one API over both platforms) and its MCP server.
PLAN_DIRECTORY_API_KEY=
# PLAN_DIRECTORY_API_URL=http://127.0.0.1:8203
